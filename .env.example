# LexisObSSOCookie value used to authenticate to the DDC4 MCP server.
# Auth is a custom `lna` header, not a bearer token. These expire — refresh from a
# logged-in session when auth starts failing. Never commit the real .env.
LEXIS_SSO_COOKIE=

# --- AWS (Bedrock) ----------------------------------------------------------
# Credentials are resolved by boto3's normal chain, so this differs by environment:
#
#   LOCAL  — set AWS_PROFILE to a named profile in ~/.aws/credentials. Required:
#            without it boto3 falls back to the `default` profile, which may not be
#            the one with Bedrock access.
#
#   SERVER — leave AWS_PROFILE UNSET. The instance role supplies credentials, and
#            naming a profile that does not exist there raises ProfileNotFound.
#
# Do not set it to an empty string expecting a fallback — the code treats empty as
# unset, but an explicit wrong value is a hard failure.
AWS_PROFILE=
AWS_REGION=us-east-1

# --- Create Search agent (create_search/, served by api.server:app) ----------
# OpenAI model keys come from AWS Secrets Manager, as in agentv4: the secret holds
# one "open_ai_*" entry per model (Model / ApiKey / RequestUri). Set this on the
# server; the instance role needs secretsmanager:GetSecretValue on it.
MODELS_SECRETS=
# Which of those entries the OpenAI provider uses by default (e.g. open_ai_gpt_5_4).
DEFAULT_OPENAI_MODEL_KEY=
# Local runs only, when MODELS_SECRETS is unset:
OPENAI_API_KEY=
OPENAI_BASE_URL=
#
# Claude runs on Bedrock (Messages API) through the AWS chain above. Override only if
# needed; Bedrock IDs keep the "anthropic." prefix:
# DEFAULT_CLAUDE_MODEL=anthropic.claude-opus-5-5
# CLAUDE_THINKING=adaptive
#
# Laptops behind a TLS-inspecting proxy only (CERTIFICATE_VERIFY_FAILED to Bedrock):
# USE_SYSTEM_CERTS=1
#
# "prod" disables /docs and requires every request to carry its own lna cookie or
# header. Anything else lets requests fall back to LEXIS_SSO_COOKIE.
ENV=dev
#
# Limits (defaults shown):
# MAX_TURNS=20
# MAX_TOOL_CALLS=40
# MAX_SEARCH_RUNS=5
# SEARCH_PREVIEW_ROWS=5
