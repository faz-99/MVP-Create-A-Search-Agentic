# LexisObSSOCookie value used to authenticate to the DDC4 MCP server.
# Auth is a cookie, not a bearer token. These expire — refresh from a logged-in
# session when auth starts failing. Never commit the real .env.
LEXIS_SSO_COOKIE=

# Provider keys — only the one you're running is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
